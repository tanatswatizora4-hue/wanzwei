# Copy to .env.local. Never commit real secrets.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# Optional
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_REPLY_TO_EMAIL=

# Gemini document extraction (server-only). Never NEXT_PUBLIC_*.
# If unset, verification stays processing / Under Review and never auto-verifies.
GEMINI_API_KEY=
# Optional override. Defaults to gemini-3.5-flash.
# GEMINI_MODEL=gemini-3.5-flash
